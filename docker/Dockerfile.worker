# StormIQ background worker image.
#
# Runs the arq worker process. Uses the same Python package as the web
# image (livestorm_app/*) but does NOT serve HTTP and does NOT bundle the
# frontend. Smaller, faster to build.
#
# Build:   docker build -f docker/Dockerfile.worker -t stormiq-worker .
# Run:     docker run --rm --env-file .env stormiq-worker

# Exact base version, matching the web image (see Dockerfile).
FROM python:3.13.18-slim-trixie AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

# requirements.txt is a hashed lock (see its header); every dependency ships
# prebuilt wheels, so no compiler toolchain is needed in the image.
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

# Backend code only. No app.py (worker doesn't serve HTTP), no
# frontend/dist, no assets/. The worker reads Postgres and Redis, calls
# the LLM providers and Gladia, and writes results back.
COPY livestorm_app ./livestorm_app
COPY prompts ./prompts

# Run unprivileged. Transcription writes only to temporary directories.
RUN useradd --create-home --uid 10001 stormiq
USER stormiq

CMD ["arq", "livestorm_app.worker.WorkerSettings"]
