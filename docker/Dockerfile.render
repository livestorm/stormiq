# StormIQ render worker image: Surprise me's MP4.
#
# Runs `livestorm_app/render_worker.py` (arq, queue `stormiq:render`, one job at
# a time). Python with the app's locked dependencies, plus Node, the pinned
# `hyperframes` CLI and its headless Chrome, GSAP, ffmpeg and the fonts, all
# installed at build time: a render needs no network. It makes no paid call
# and needs only DATABASE_URL and REDIS_URL.
#
# Build:   docker build --platform linux/amd64 -f docker/Dockerfile.render -t stormiq-render .
# Run:     docker run --rm -e DATABASE_URL=... -e REDIS_URL=... stormiq-render

# Exact versions. Keep Node in sync with frontend/.nvmrc and the web image.
FROM node:26.13.0-bookworm-slim AS node

FROM python:3.13.18-slim-trixie AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    HYPERFRAMES_NO_TELEMETRY=1 \
    DO_NOT_TRACK=1 \
    HYPERFRAMES_BIN=/opt/stormiq-render/node_modules/.bin/hyperframes \
    GSAP_JS_PATH=/opt/stormiq-render/node_modules/gsap/dist/gsap.min.js \
    FFMPEG_BIN=ffmpeg

# ffmpeg (the mix, and HyperFrames' encoder), the colour emoji font, and the
# libraries headless Chrome needs.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates ffmpeg fonts-noto-color-emoji fontconfig \
        libnss3 libnspr4 libatk1.0-0t64 libatk-bridge2.0-0t64 libcups2t64 libdrm2 libdbus-1-3 \
        libxkbcommon0 libxcomposite1 libxdamage1 libxfixes3 libxrandr2 libxext6 libx11-6 libxcb1 \
        libgbm1 libasound2t64 libpango-1.0-0 libcairo2 libxshmfence1 libexpat1 \
    && rm -rf /var/lib/apt/lists/*

# Node from the official image (its binary and npm).
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -s /usr/local/lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && ln -s /usr/local/lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx \
    && node --version

# The pinned renderer and GSAP (GSAP is installed here, not committed).
RUN mkdir -p /opt/stormiq-render \
    && npm install --prefix /opt/stormiq-render --no-audit --no-fund --save-exact hyperframes@0.9.34 gsap@3.15.0 \
    && test -f "$GSAP_JS_PATH" && "$HYPERFRAMES_BIN" --version

# requirements.txt is a hashed lock (see its header).
WORKDIR /app
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

COPY livestorm_app ./livestorm_app
# The Sora font and the IQ monogram the video draws (read from the frontend's files).
COPY frontend/public/fonts/Sora-Variable-latin.woff2 frontend/public/fonts/Sora-OFL.txt ./frontend/public/fonts/
COPY frontend/public/favicon.svg ./frontend/public/favicon.svg

# Run unprivileged; HyperFrames' Chrome is downloaded into this user's cache at build time.
RUN useradd --create-home --uid 10001 stormiq
USER stormiq
RUN "$HYPERFRAMES_BIN" browser ensure && fc-list | grep -qi "Noto Color Emoji"

CMD ["arq", "livestorm_app.render_worker.WorkerSettings"]
