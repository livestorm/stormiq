# StormIQ local configuration. Copy to `.env` and fill in what you need.
# Placeholders only: never commit real values. Full reference: docs/operations.md.
# Keep comments on their own lines: the app's .env loader does not strip
# inline comments from values.

# ── Local development ──────────────────────────────────────────────────────
# Skip OAuth locally: requests without a session use LS_API_KEY (docs/security.md).
# Ignored on Render. Only works on http://localhost / 127.0.0.1.
STORMIQ_LOCAL_DEV=1
LS_API_KEY=

# ── Database and queue (local services from docker-compose.yml) ────────────
# Start them with: docker compose up -d postgres redis
# Never point local development at the production database.
DATABASE_URL=postgresql://stormiq:stormiq@localhost:5433/stormiq
REDIS_URL=redis://localhost:6379/0

# ── AI providers ───────────────────────────────────────────────────────────
# CLAUDE_API_KEY: every text job runs on Claude. OPENAI_API_KEY: Surprise me's backup voice only.
CLAUDE_API_KEY=
OPENAI_API_KEY=

# ── Transcription ──────────────────────────────────────────────────────────
GLADIA_KEY=

# ── Livestorm OAuth (optional locally when STORMIQ_LOCAL_DEV=1) ────────────
LIVESTORM_OAUTH_CLIENT_ID=
LIVESTORM_OAUTH_CLIENT_SECRET=
LIVESTORM_OAUTH_REDIRECT_URI=http://localhost:10000/api/auth/livestorm/callback
# LIVESTORM_OAUTH_SCOPES=identity:read events:read
# FRONTEND_APP_URL=http://localhost:5173
# SESSION_SECRET: any long random string
SESSION_SECRET=

# ── Admin ──────────────────────────────────────────────────────────────────
# ADMIN_EMAILS=you@example.com
